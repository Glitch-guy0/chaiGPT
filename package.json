{
  "name": "chaigpt",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "start:dev:infra": "docker compose -f infra/docker-compose.yml up -d",
    "stop:dev:infra": "docker compose -f infra/docker-compose.yml down",
    "stop:dev:infra:clean": "docker compose -f infra/docker-compose.yml down -v",
    "start:dev": "npm run start:dev:infra && npm run dev",
    "start:prod": "docker compose -f infra/docker-compose.yml -f infra/docker-compose.prod.yml up -d --build",
    "stop:prod": "docker compose -f infra/docker-compose.yml -f infra/docker-compose.prod.yml down",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/data-source.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.20",
    "@langchain/core": "^1.2.3",
    "@langchain/openai": "^1.5.5",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-slot": "^1.3.0",
    "@tanstack/react-query": "^5.101.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "langchain": "^1.5.3",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "pg": "^8.13.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "reflect-metadata": "^0.2.2",
    "tailwind-merge": "^3.6.0",
    "typeorm": "^0.3.21",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
