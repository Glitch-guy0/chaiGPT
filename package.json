{
  "name": "chaigpt",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "start:dev:infra": "docker compose -f infra/docker-compose.yml up -d && next dev",
    "stop:dev:infra": "docker compose -f infra/docker-compose.yml down",
    "start:prod": "docker compose -f infra/docker-compose.yml up -d && next build && next start",
    "stop:prod": "docker compose -f infra/docker-compose.yml down"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.20",
    "@langchain/core": "^1.2.3",
    "@langchain/openai": "^1.5.5",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-slot": "^1.3.0",
    "@tanstack/react-query": "^5.101.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "langchain": "^1.5.3",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "reflect-metadata": "^0.2.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^1.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
