{
  "name": "chaigpt",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "start:dev:infra": "docker-compose -f infra/docker-compose.yml up -d --wait",
    "stop:dev:infra": "docker-compose -f infra/docker-compose.yml down && docker volume ls -q -f name=chaigpt_assets | xargs -r docker volume rm 2>/dev/null || true",
    "start:dev": "npm run start:dev:infra && npm run dev",
    "start:prod": "docker-compose -f infra/docker-compose.yml --profile prod up -d --build --wait",
    "stop:prod": "docker-compose -f infra/docker-compose.yml --profile prod down && docker volume ls -q -f name=chaigpt_assets | xargs -r docker volume rm 2>/dev/null || true",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/lib/db/index.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/lib/db/index.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate src/lib/db/migrations/MigrationName -d src/lib/db/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npx playwright test --config=e2e/playwright.config.ts",
    "test:e2e:smoke": "npx playwright test --config=e2e/playwright.config.ts --grep @smoke",
    "test:e2e:ui": "npx playwright test --config=e2e/playwright.config.ts --ui",
    "test:e2e:docker": "docker compose -f infra/docker-compose.yml -f infra/docker-compose.e2e.yml up --build -d && npx playwright test --config=e2e/playwright.config.ts; EXIT_CODE=$?; docker compose -f infra/docker-compose.yml -f infra/docker-compose.e2e.yml down -v; exit $EXIT_CODE"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.20",
    "@langchain/core": "^1.2.3",
    "@langchain/openai": "^1.5.5",
    "@langchain/textsplitters": "^1.0.1",
    "@qdrant/js-client-rest": "^1.18.0",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-slot": "^1.3.0",
    "@tanstack/react-query": "^5.101.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^5.11.1",
    "langchain": "^1.5.3",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "reflect-metadata": "^0.2.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "typeorm": "^0.3.21",
    "uuid": "^14.0.1",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "better-sqlite3": "^11.10.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "sqlite3": "^5.1.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
