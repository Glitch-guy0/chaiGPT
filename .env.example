# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chaigpt
DB_USER=chaigpt
DB_PASSWORD=chaigpt
DATABASE_URL=postgres://chaigpt:chaigpt@localhost:5432/chaigpt

# Qdrant
QDRANT_URL=http://localhost:6333

# Clerk (required for auth — Story 2.3)
# Get keys from https://dashboard.clerk.com/ > API Keys
# These are Clerk test keys from the development instance
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_UP_URL=/sign-up

# OpenAI (required for LLM — Story 3.4)
OPENAI_API_KEY=

# Jina (required for web search — Story 7.1)
JINA_API_KEY=

# Assets volume path (Docker volume mount point)
ASSETS_VOLUME_PATH=/app/assets

# E2E test user credentials (required for Playwright e2e tests — Story 2.6)
# Create a test user in the Clerk dev dashboard and populate these:
CLERK_E2E_EMAIL=e2e-test-user@example.com
CLERK_E2E_PASSWORD=e2e-test-password

# E2E-specific database URL (overrides DATABASE_URL for the e2e Postgres container)
DATABASE_URL_E2E=postgresql://postgres:postgres@localhost:5432/chaiGPT_e2e
